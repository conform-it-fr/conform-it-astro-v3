---
import ThemeBadge from "./ThemeBadge.astro";

interface Props {
  title: string;
  class?: string;
  /** slug d'une thématique du catalogue : affiche le badge correspondant en haut de la carte. */
  badge?: string;
}

const { title, class: className = "", badge } = Astro.props;
---

<div class:list={["rounded-2xl border border-slate-100 bg-cream-50 p-6 shadow-sm transition-shadow hover:shadow-md", className]}>
  {badge && (
    <div class="mx-auto mb-4 w-24" aria-hidden="true">
      <ThemeBadge slug={badge} />
    </div>
  )}
  <h2 class="text-lg font-semibold text-slate-900">{title}</h2>
  <div class="mt-3 text-sm leading-relaxed text-slate-600">
    <slot />
  </div>
</div>
