---
import QuizGroup from "./QuizGroup.astro";
import ThemeBadge from "./ThemeBadge.astro";

interface Props {
  formId: string;
  endpoint: string;
  submitLabel?: string;
  /** slug de thématique du catalogue pour le badge visuel (facultatif). */
  theme?: string;
  /** court paragraphe de contexte réglementaire affiché en encadré au-dessus du questionnaire. */
  contexte?: string;
}

const { formId, endpoint, submitLabel = "Obtenir mon résultat", theme, contexte } = Astro.props;
const resultId = `${formId}-result`;
---

{theme && (
  <div class="mx-auto -mt-2 mb-6 w-32 sm:w-36" aria-hidden="true">
    <ThemeBadge slug={theme} />
  </div>
)}

{contexte && (
  <div class="mx-auto mb-8 max-w-3xl rounded-2xl border border-slate-200 bg-cream-100 p-5 text-sm text-slate-700">
    <strong class="text-slate-900">Pourquoi cet outil ?</strong> {contexte}
  </div>
)}

<div class="mx-auto max-w-3xl">
  <!-- Progression -->
  <div id={`${formId}-progress`} class="mb-8 flex items-center gap-4">
    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
      <div class="qf-progress-fill h-full w-0 rounded-full bg-accent-600 transition-all duration-300"></div>
    </div>
    <p class="qf-progress-label whitespace-nowrap text-xs font-semibold text-slate-500">0 / 0 réponses</p>
  </div>

  <div class="hidden" aria-hidden="true">
    <label for={`${formId}-website`}>Ne pas remplir</label>
    <input type="text" id={`${formId}-website`} name="website" autocomplete="off" tabindex="-1" />
  </div>

  <form id={formId} data-endpoint={endpoint} data-result={resultId} novalidate class="space-y-6">
    <slot />

    <QuizGroup title="Vos coordonnées">
      <div>
        <label for={`${formId}-orga`} class="text-sm font-semibold text-slate-900">
          Nom de votre organisation <span aria-hidden="true" class="text-terracotta-600">*</span>
        </label>
        <input
          id={`${formId}-orga`}
          name="orga"
          type="text"
          required
          class="mt-1.5 w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20"
        />
      </div>
      <div>
        <label for={`${formId}-email`} class="text-sm font-semibold text-slate-900">
          Email professionnel <span aria-hidden="true" class="text-terracotta-600">*</span>
        </label>
        <input
          id={`${formId}-email`}
          name="email"
          type="email"
          required
          class="mt-1.5 w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20"
        />
      </div>
    </QuizGroup>

    <div class="pt-2 text-center">
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-terracotta-600 px-8 py-4 text-base font-bold text-cream-50 transition-colors hover:bg-terracotta-700"
      >
        {submitLabel}
      </button>
      <p class="mt-3 text-xs text-slate-400">Votre résultat s'affiche ci-dessous, dès l'envoi du questionnaire.</p>
    </div>
  </form>

  <!-- Résultat : sous le bouton, en carte pleine largeur -->
  <div id={resultId} aria-live="polite" class="qf-result mt-8 rounded-2xl border border-slate-200 bg-cream-50 p-6 text-sm text-slate-700 shadow-sm sm:p-8"></div>

  <p class="mt-6 text-xs leading-relaxed text-slate-400">
    Les informations recueillies via ce questionnaire sont traitées par conform-IT afin d'évaluer votre niveau
    d'exposition réglementaire et de vous proposer, le cas échéant, un accompagnement adapté. Les données
    collectées sont strictement nécessaires à cette finalité et ne sont pas cédées à des tiers. Elles sont
    conservées pour une durée maximale de 12 mois. Conformément au Règlement (UE) 2016/679 (RGPD), vous disposez
    d'un droit d'accès, de rectification, d'opposition et de suppression de vos données en nous contactant à
    l'adresse suivante : contact@conform-it.fr.
  </p>
</div>

<style>
  /* La carte de résultat n'apparaît qu'une fois remplie. */
  .qf-result:empty {
    display: none;
  }
</style>

<script>
  function initQuizForms(root: ParentNode) {
    root.querySelectorAll<HTMLFormElement>("form[data-endpoint]").forEach((form) => {
      if (form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const wrap = form.closest("div");
      const fill = wrap?.querySelector<HTMLElement>(".qf-progress-fill");
      const label = wrap?.querySelector<HTMLElement>(".qf-progress-label");

      const radioNames = Array.from(
        new Set(
          Array.from(form.querySelectorAll<HTMLInputElement>('input[type="radio"]')).map((r) => r.name),
        ),
      );
      const total = radioNames.length;

      function updateProgress() {
        const done = radioNames.filter((name) => form.querySelector(`input[name="${name}"]:checked`)).length;
        if (fill) fill.style.width = (total ? (done / total) * 100 : 0) + "%";
        if (label) label.textContent = `${done} / ${total} réponses`;
      }

      form.addEventListener("change", (event) => {
        const target = event.target as HTMLInputElement;
        if (target.type === "radio") updateProgress();
      });
      updateProgress();

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const endpoint = form.dataset.endpoint!;
        const resultId = form.dataset.result!;
        const resultEl = document.getElementById(resultId);
        const formData = new FormData(form);

        if (resultEl) resultEl.textContent = "Analyse de vos réponses…";

        fetch(endpoint, { method: "POST", body: formData })
          .then((r) => (r.ok ? r.text() : Promise.reject(`Erreur HTTP : ${r.status}`)))
          .then((html) => {
            if (!resultEl) return;
            resultEl.innerHTML = html;
            resultEl.scrollIntoView({ behavior: "smooth", block: "start" });
          })
          .catch((err) => {
            if (resultEl) resultEl.textContent = `Erreur lors de l'envoi : ${err}`;
          });
      });
    });
  }

  initQuizForms(document);
  document.addEventListener("astro:page-load", () => initQuizForms(document));
</script>
