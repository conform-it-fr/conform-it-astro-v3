---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost" | "ghost-dark";
  class?: string;
  id?: string;
}

const { href, variant = "primary", class: className = "", id } = Astro.props;

const variants = {
  primary: "bg-terracotta-600 text-cream-50 hover:bg-terracotta-700",
  secondary: "bg-slate-900 text-cream-50 hover:bg-slate-700",
  ghost: "bg-transparent text-slate-900 ring-1 ring-inset ring-slate-200 hover:bg-cream-100",
  "ghost-dark": "bg-transparent text-cream-50 ring-1 ring-inset ring-slate-600 hover:bg-slate-800",
};
---

<a
  href={href}
  id={id}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors",
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
