---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieNotice from "../components/CookieNotice.astro";

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** true → carte Twitter/X grand format (`summary_large_image`). À réserver aux pages avec une vraie illustration. */
  ogImageLarge?: boolean;
  noindex?: boolean;
  /** Données structurées supplémentaires (schema.org) propres à la page. Objet(s) JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "conform-IT forme les équipes des PME à la conformité — IA (AI Act), RGPD, cybersécurité et 6 autres thématiques — et laisse un registre exportable qui prouve qui a été formé, quand et sur quoi.",
  ogTitle,
  ogDescription,
  ogImage = "/conform-it-logo-maillage-confine-60x60.webp",
  ogImageAlt = "conform-IT",
  ogImageLarge = false,
  noindex = false,
  jsonLd,
} = Astro.props;

const resolvedOgTitle = ogTitle || `${title} - conform-IT`;
const resolvedOgDescription = ogDescription || description;
const ogImageURL = new URL(ogImage, Astro.site);

// Données structurées : l'organisation est décrite sur toutes les pages ; chaque page
// peut ajouter les siennes via la prop `jsonLd` (WebSite, BlogPosting, Course…).
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "conform-IT",
  legalName: "conform-IT SARL",
  url: Astro.site?.href,
  logo: new URL("/conform-it-logo-maillage-confine-60x60.webp", Astro.site).href,
  description:
    "Organisme de formation à la conformité pour les PME : IA (AI Act), RGPD, cybersécurité, NIS2, non-discrimination, harcèlement, anti-corruption, sobriété numérique, accessibilité web.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "17 boulevard de Strasbourg",
    postalCode: "62000",
    addressLocality: "Arras",
    addressCountry: "FR",
  },
  areaServed: "FR",
};

const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [organizationLd, ...pageLd];

// Indexation activée uniquement quand PUBLIC_ENABLE_INDEXING=true est passé au build
// (build de production). Par défaut (staging/beta), noindex — voir README pour les commandes.
// `noindex` (prop) force le noindex au niveau de la page, quel que soit l'environnement :
// pages utilitaires (confirmations, redirections, erreurs) sans valeur de résultat de recherche.
const indexingEnabled = import.meta.env.PUBLIC_ENABLE_INDEXING === "true" && !noindex;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Mesure d'audience GoatCounter (sans cookie) : chargée uniquement sur le build de production
// (PUBLIC_ENABLE_INDEXING=true) pour ne pas polluer les statistiques avec les visites de staging/dev.
const analyticsEnabled = import.meta.env.PUBLIC_ENABLE_INDEXING === "true";
// Sous-domaine du compte GoatCounter (à créer sur https://www.goatcounter.com/).
const goatcounterUrl = "https://conform-it.goatcounter.com/count";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0519ad" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="robots" content={indexingEnabled ? "index, follow" : "noindex, nofollow"} />
    <title>{title} - conform-IT</title>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="conform-IT" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content={ogImageLarge ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    {analyticsEnabled && (
      <script
        data-goatcounter={goatcounterUrl}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}

    <!-- Styles/métadonnées propres à une page (ex. CSS critique généré) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-cream-50 font-sans antialiased">
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
  </body>
</html>
