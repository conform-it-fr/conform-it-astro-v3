---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import ThemeBadge from "../../components/ThemeBadge.astro";
import { themes } from "../../data/themes";

// Hiérarchie « essentiels » (formation de masse en priorité) vs reste du catalogue.
// Ne touche pas src/data/themes.ts : on se contente de partitionner la liste par slug.
const SLUGS_ESSENTIELS = ["intelligence-artificielle", "rgpd", "cybersecurite"];
const essentiels = SLUGS_ESSENTIELS
  .map((s) => themes.find((t) => t.slug === s))
  .filter((t): t is (typeof themes)[number] => Boolean(t));
const catalogueComplet = themes.filter((t) => !SLUGS_ESSENTIELS.includes(t.slug));

const inclus = [
  "Accès illimité à tout le catalogue ci-dessus",
  "Un parcours par rôle pour vos 4 publics",
  "Badges horodatés et registre exportable",
  "Espace d'administration",
  "Veille et mises à jour du contenu",
];

const publics = [
  { titre: "Dirigeants", texte: "Quoi déployer, quoi encadrer, quoi refuser." },
  { titre: "Usagers", texte: "Ce qu'on peut faire, comment vérifier." },
  { titre: "Managers", texte: "Valider les usages de son service, arbitrer." },
  { titre: "Créateurs", texte: "Concevoir assistants et automatisations sans exposer l'entreprise." },
];
---

<BaseLayout
  title="Catalogue de formations à la conformité"
  description="Le catalogue conform-IT : IA (AI Act), RGPD, cybersécurité, NIS2 et 5 autres thématiques. Tout est inclus dans le forfait plateforme."
>
  <Section as="h1"
    tone="white"
    eyebrow="Catalogue"
    title="Toutes vos obligations de conformité, un seul espace"
    description="Formez tout le monde en priorité sur les trois essentiels — IA, RGPD, cybersécurité — puis élargissez au reste du catalogue. Tout est inclus dans le même forfait plateforme."
  >
    <!-- Bloc 1 : les essentiels -->
    <div class="mb-14">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="text-xl font-bold text-slate-900">Les essentiels</h2>
        <p class="text-sm text-slate-500">Les trois thèmes que la plupart de nos clients déploient en premier, pour tous leurs salariés.</p>
      </div>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {essentiels.map((t) => (
          <a href={`/formations/${t.slug}/`} class="group relative flex flex-col rounded-2xl border-2 border-terracotta-400 bg-cream-50 p-6 pt-12 shadow-sm transition-shadow hover:shadow-md sm:p-7 sm:pt-12">
            <span class="absolute left-4 top-4 rounded-full bg-terracotta-100 px-2.5 py-1 text-xs font-semibold text-terracotta-700">Le plus demandé</span>
            <div class="mx-auto mb-4 w-32 sm:w-36" aria-hidden="true">
              <ThemeBadge slug={t.slug} />
            </div>
            <h3 class="text-lg font-semibold text-slate-900 sm:text-xl">{t.titre}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{t.resume}</p>
            <span class="mt-4 text-sm font-semibold text-terracotta-600">Voir le parcours →</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bloc 2 : le reste du catalogue -->
    <div>
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="text-xl font-bold text-slate-900">Catalogue complet</h2>
        <p class="text-sm text-slate-500">Les six autres thématiques, à activer selon vos obligations et votre calendrier.</p>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {catalogueComplet.map((t) => (
          <a href={`/formations/${t.slug}/`} class="flex flex-col rounded-2xl border border-slate-100 bg-cream-50 p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="mx-auto mb-4 w-24 sm:w-28" aria-hidden="true">
              <ThemeBadge slug={t.slug} />
            </div>
            <h3 class="text-lg font-semibold text-slate-900">{t.titre}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{t.resume}</p>
            <span class="mt-4 text-sm font-semibold text-terracotta-600">Voir le parcours →</span>
          </a>
        ))}
      </div>
    </div>
  </Section>

  <!-- Ce qui est inclus -->
  <Section tone="cream" eyebrow="Le forfait plateforme" title="Ce qui est inclus, ce qui est en option">
    <div class="mx-auto grid max-w-4xl gap-10 sm:grid-cols-2">
      <div>
        <h3 class="text-base font-semibold text-slate-900">Inclus dans le forfait</h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-700">
          {inclus.map((item) => (
            <li class="flex gap-2">
              <svg aria-hidden="true" focusable="false" class="mt-0.5 h-4 w-4 flex-none text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-base font-semibold text-slate-900">En option</h3>
        <p class="mt-4 text-sm text-slate-600">
          L'accompagnement sur site : séance dirigeants, ateliers par métier, atelier créateurs, rédaction
          de vos règles d'usage, revue de vos usages réels. Facturé à la journée.
        </p>
        <a href="/offre/" class="mt-4 inline-block text-sm font-semibold text-terracotta-600 hover:underline">Voir la grille tarifaire →</a>
      </div>
    </div>
  </Section>

  <!-- Les quatre publics -->
  <Section tone="white" eyebrow="Notre méthode" title="Quatre publics, quatre parcours" description="La plupart des réglementations demandent des mesures adaptées au rôle de chacun. C'est exactement la façon dont nos parcours sont construits.">
    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(150px,1fr))]">
      {publics.map((p) => (
        <div class="rounded-2xl bg-cream-50 p-5">
          <h3 class="text-sm font-semibold text-slate-900">{p.titre}</h3>
          <p class="mt-2 text-sm text-slate-600">{p.texte}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Ce que la loi n'impose pas -->
  <Section tone="cream">
    <div class="mx-auto max-w-2xl rounded-xl border border-slate-200 bg-cream-50 p-6 text-center sm:p-8">
      <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">Ce que la loi n'impose pas</h2>
      <p class="mt-4 text-sm text-slate-600">
        Contrairement à ce qu'on lit souvent, l'AI Act n'impose ni certificat, ni examen, ni nombre d'heures
        minimum, ni module obligatoire, ni charte imposée. Ce qui est demandé : des mesures adaptées au rôle
        de chacun, et de quoi montrer qu'elles ont été prises. C'est exactement ce que nous livrons — ni plus,
        ni moins.
      </p>
    </div>
  </Section>

  <Section tone="navy" title="Voir les tarifs et démarrer">
    <div class="flex flex-wrap justify-center gap-4">
      <Button href="/offre/" variant="primary">Voir la grille tarifaire</Button>
      <Button href="/contact/" variant="ghost-dark">Nous contacter</Button>
    </div>
  </Section>
</BaseLayout>
