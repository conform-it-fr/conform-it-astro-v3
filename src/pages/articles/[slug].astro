---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pubIso = post.data.pubDate.toISOString();
const pubLabel = post.data.pubDate.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
const canonical = new URL(`/articles/${post.id}/`, Astro.site).href;

// SEO : titre et meta description dédiés si fournis, sinon repli sur le titre éditorial / le résumé.
const seoTitle = post.data.seoTitle || post.data.title;
const metaDescription = post.data.metaDescription || post.data.description;

const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: metaDescription,
  datePublished: pubIso,
  dateModified: pubIso,
  inLanguage: "fr-FR",
  mainEntityOfPage: canonical,
  url: canonical,
  ...(post.data.category ? { articleSection: post.data.category } : {}),
  ...(post.data.image ? { image: new URL(post.data.image, Astro.site).href } : {}),
  author: { "@type": "Organization", name: "conform-IT" },
  publisher: {
    "@type": "Organization",
    name: "conform-IT",
    logo: { "@type": "ImageObject", url: new URL("/conform-it-logo-maillage-confine-60x60.webp", Astro.site).href },
  },
};
---

<BaseLayout
  title={seoTitle}
  description={metaDescription}
  ogImage={post.data.image}
  ogImageAlt={post.data.imageAlt}
  ogImageLarge={Boolean(post.data.image)}
  noindex={post.data.noindex}
  jsonLd={blogPostingLd}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <div class="flex items-center gap-2 text-sm font-medium text-slate-400">
      <time datetime={pubIso}>{pubLabel}</time>
      {post.data.category && (
        <>
          <span aria-hidden="true">·</span>
          <span class="font-semibold text-terracotta-600">{post.data.category}</span>
        </>
      )}
    </div>
    <h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">{post.data.title}</h1>

    {post.data.image && (
      <img
        src={post.data.image}
        alt={post.data.imageAlt || `Illustration de l’article : ${post.data.title}`}
        class="mt-8 w-full rounded-2xl border border-slate-100 object-cover"
      />
    )}

    <div class="prose prose-slate mt-8 max-w-none prose-headings:font-semibold prose-headings:text-slate-900 prose-a:text-terracotta-600 prose-strong:text-slate-900 prose-img:rounded-xl prose-img:border prose-img:border-slate-100">
      <Content />
    </div>

    <a href="/articles/" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold text-terracotta-600 hover:text-terracotta-600">
      ← Retour aux articles
    </a>
  </article>
</BaseLayout>
