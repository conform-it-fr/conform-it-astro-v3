RewriteEngine On

# ── Canonicalisation du domaine : tout ce qui n'est pas www.conform-it.fr ──
# ── est redirigé en 301 vers www (évite le contenu dupliqué www / non-www). ──
RewriteCond %{HTTP_HOST} !^www\.conform-it\.fr$ [NC]
RewriteRule ^(.*)$ https://www.conform-it.fr/$1 [R=301,L]

# ── Pages déplacées / fusionnées (vérifié contre le sitemap Publii) ──
RewriteRule ^a-propos/?$ /presentation-de-conform-it/ [R=301,L]

# ── Refonte tarifaire 08/2026 : tunnel IA (3 pages) fusionné dans /offre/ ──
RewriteRule ^audit-des-systemes-ia/?$ /offre/ [R=301,L]
RewriteRule ^mise-en-conformite-ia/?$ /offre/ [R=301,L]
RewriteRule ^pilotage-des-systemes-ia/?$ /offre/ [R=301,L]

# ── CGV retirées (08/2026) : les conditions de vente ne concernent pas ce site ──
RewriteRule ^cgv/?$ /cgu/ [R=301,L]

